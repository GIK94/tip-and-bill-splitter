# Copy to src/.env before running `docker compose up`.
# These values are for LOCAL use only — change the secrets for any shared or deployed environment.

# Port the app is served on: http://localhost:8080
APP_PORT=8080

# MySQL
DB_NAME=tip_splitter
DB_USER=tip_splitter
DB_PASSWORD=change-me-local-db-password
DB_ROOT_PASSWORD=change-me-local-root-password

# Signs session tokens. Must be at least 32 characters; use a long random value.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Set to true when serving over HTTPS so the session cookie is only sent securely.
COOKIE_SECURE=false
